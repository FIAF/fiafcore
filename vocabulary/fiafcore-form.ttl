    skos:topConceptOf <https://vocabulary.fiafcore.org/form/> ;
    rdfs:label "Home Movie"@en ;
    rdfs:subClassOf <https://ontology.fiafcore.org/form> ;
.

<https://vocabulary.fiafcore.org/Form/Outtake> a owl:Class, skos:Concept;
    skos:prefLabel "Outtake"@en ;
    skos:topConceptOf <https://vocabulary.fiafcore.org/form/> ;
    rdfs:label "Outtake"@en ;
    rdfs:subClassOf <https://ontology.fiafcore.org/form> ;
.

<https://vocabulary.fiafcore.org/Form/ScreenTest> a owl:Class, skos:Concept;
    skos:prefLabel "Screen Test"@en ;
    skos:topConceptOf <https://vocabulary.fiafcore.org/form/> ;
    rdfs:label "Screen Test"@en ;
    rdfs:subClassOf <https://ontology.fiafcore.org/form> ;
.

<https://vocabulary.fiafcore.org/Form/Serial> a owl:Class, skos:Concept;
    skos:prefLabel "Serial"@en ;
    skos:topConceptOf <https://vocabulary.fiafcore.org/form/> ;
    rdfs:label "Serial"@en ;
    rdfs:subClassOf <https://ontology.fiafcore.org/form> ;
