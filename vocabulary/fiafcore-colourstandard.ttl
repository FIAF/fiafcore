PREFIX colo: <https://vocabulary.fiafcore.org/colourstandard/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<https://vocabulary.fiafcore.org/colourstandard/> a skos:ConceptScheme;
    skos:hasTopConcept colo:Agfacolor, colo:DeLuxe, colo:Duartcolor, colo:Eastmancolor, colo:Fujicolor, colo:Metrocolor, colo:Orwocolor, colo:Technicolor ;
    skos:prefLabel "Colour Standard"@en ;
    skos:definition "A standardised colour process."@en ;
.

<https://ontology.fiafcore.org/ColourStandard> a owl:Class ;
    rdfs:label "Colour Standard"@en ;
    dc:description "A standardised colour process."@en ;
.

<https://vocabulary.fiafcore.org/base/Agfacolor> a owl:Class, skos:Concept;
    skos:prefLabel "Agfacolor"@en ;
    skos:definition ""@en ;
    skos:topConceptOf <https://vocabulary.fiafcore.org/colourstandard/> ;
    rdfs:label "Agfacolor"@en ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ColourStandard> ;
.

