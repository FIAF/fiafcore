    skos:definition "Waveform Audio File Format, including Broadcast Wave."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "WAV"@en ;
.

<https://dev.fiafcore.org/WebM>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/ContainerFormat> ;
    skos:definition "The WebM container format."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "WebM"@en ;
.

<https://dev.fiafcore.org/QuarterInchAudiotape>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/OpenReelAudiotape> ;
    skos:definition "Quarter-inch open-reel magnetic audio tape."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Quarter Inch Audiotape"@en ;
.

<https://dev.fiafcore.org/AudioDisc>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/AudioFormat> ;
    skos:definition "A physical audio disc format played on an audio disc player. Use when no more specific format is known."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Audio Disc"@en ;
.

<https://dev.fiafcore.org/AudioFormat>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/Format> ;
    skos:definition "A physical audio carrier other than film, played on audio playback equipment, such as open-reel magnetic tape, an audio cassette, or an audio compact disc."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Audio Format"@en ;
.

<https://dev.fiafcore.org/Betacam>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/VideoTape> ;
    skos:definition "The Betacam family of half inch component videocassette formats."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Betacam"@en ;
.

<https://dev.fiafcore.org/MagneticFilm>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/FilmFormat> ;
    skos:definition "Perforated film carrying a magnetic sound recording, fullcoat or stripe on a clear base, played on flatbed editors and viewers or sound followers rather than projectors. Use when the gauge is unknown. A picture print with a magnetic stripe is a picture film format with a magnetic sound standard, not magnetic film."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Magnetic Film"@en ;
.

<https://dev.fiafcore.org/VideoFormat>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/Format> ;
    skos:definition "A physical video format played on video decks or players: a videotape, videocassette, or video disc."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Video Format"@en ;
.

<https://dev.fiafcore.org/DigitalFormat>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/Format> ;
    skos:definition "The format of a digital object, comprising a single file or a unit of related files, such as a file container, an image file format, or a deliverable package. Read with software, independently of the storage medium holding it. Codecs describe individual digital streams rather than the format of the enclosing object."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Digital Format"@en ;
.

<https://dev.fiafcore.org/OneInchVideotape>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/VideoTape> ;
    skos:definition "One-inch open-reel videotape. Use when the type (A, B, or C) is unknown."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "One Inch Videotape"@en ;
.

<https://dev.fiafcore.org/PackageFormat>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/DigitalFormat> ;
    skos:definition "A defined deliverable package combining image, audio, and metadata files, rather than a single file container."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Package Format"@en ;
.

<https://dev.fiafcore.org/Umatic>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/VideoTape> ;
    skos:definition ""@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "U-matic"@en ;
.

<https://dev.fiafcore.org/AudioTape>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/AudioFormat> ;
    skos:definition "A magnetic audio tape or audio cassette format. Use when no more specific format is known. Excludes perforated magnetic film."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Audio Tape"@en ;
.

<https://dev.fiafcore.org/DV>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/VideoTape> ;
    skos:definition "The DV family of digital videocassette formats."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "DV"@en ;
.

<https://dev.fiafcore.org/ImageFormat>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/DigitalFormat> ;
    skos:definition "A digital image file format combining image data and associated metadata. Image data may be compressed or uncompressed."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Image Format"@en ;
.

<https://dev.fiafcore.org/LTO>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/DataStorageFormat> ;
    skos:definition "Linear Tape-Open magnetic data tape storage format."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "LTO"@en ;
.

<https://dev.fiafcore.org/OpenReelAudiotape>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/AudioTape> ;
    skos:definition "An open-reel magnetic audio tape format, with tape width unspecified unless a narrower term is used. Excludes perforated magnetic film."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Open-Reel Audiotape"@en ;
.

<https://dev.fiafcore.org/VideoDisc>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/VideoFormat> ;
    skos:definition "A video disc format played on a video disc player or deck, whatever the reading method. Use when no more specific format is known."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Video Disc"@en ;
.

<https://dev.fiafcore.org/ContainerFormat>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/DigitalFormat> ;
    skos:definition "A digital file container holding one or more image, audio, or metadata streams."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Container Format"@en ;
.

<https://dev.fiafcore.org/DataStorageFormat>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/Format> ;
    skos:definition "A physical storage medium read by a computer drive, holding digital data without determining the format of the digital objects stored on it, such as data tape, a hard disk drive, an optical data disc, or flash memory. Whether a disc is recordable or pressed does not by itself make it a data storage format; an authored audio or video disc is an audio or video format."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Data Storage Format"@en ;
.

<https://dev.fiafcore.org/FilmFormat>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/Format> ;
    skos:definition "A perforated motion-picture film format, photochemical or magnetic, read with sprocketed film equipment such as projectors, flatbed editors and viewers, sound followers, or film scanners."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Film Format"@en ;
.

<https://dev.fiafcore.org/VideoTape>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/VideoFormat> ;
    skos:definition "A videotape or videocassette format, analogue or digital. Use when no more specific format is known."@en ;
    skos:inScheme <https://dev.fiafcore.org/Format> ;
    skos:prefLabel "Video Tape"@en ;
.

<https://dev.fiafcore.org/Format>
    a skos:ConceptScheme ;
    skos:definition "The physical or digital technical form of a moving image object, identifying the family of equipment or software needed to read, decode, or play back that specific object. A storage medium and a digital object stored on it are separate objects with separate formats. Digital stream encodings are described separately with hasVideoCodec or hasAudioCodec."@en ;
    skos:prefLabel "Format"@en ;
.
