PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<https://dev.fiafcore.org/BlackAndWhite>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/ColourCharacteristic> ;
    skos:definition ""@en ;
    skos:inScheme <https://dev.fiafcore.org/ColourCharacteristic> ;
    skos:prefLabel "Black And White"@en ;
.

<https://dev.fiafcore.org/Colour>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/ColourCharacteristic> ;
    skos:definition ""@en ;
    skos:inScheme <https://dev.fiafcore.org/ColourCharacteristic> ;
    skos:prefLabel "Colour"@en ;
.

<https://dev.fiafcore.org/Tinted>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/ColourCharacteristic> ;
    skos:definition ""@en ;
    skos:inScheme <https://dev.fiafcore.org/ColourCharacteristic> ;
    skos:prefLabel "Tinted"@en ;
.

<https://dev.fiafcore.org/Toned>
    a skos:Concept ;
    skos:broader <https://dev.fiafcore.org/ColourCharacteristic> ;
    skos:definition ""@en ;
    skos:inScheme <https://dev.fiafcore.org/ColourCharacteristic> ;
    skos:prefLabel "Toned"@en ;
.

<https://dev.fiafcore.org/ColourCharacteristic>
    a skos:ConceptScheme ;
    skos:definition ""@en ;
    skos:prefLabel "Colour Characteristic"@en ;
.
