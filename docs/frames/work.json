{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "fiaf": "https://dev.fiafcore.org",
    "label": {
      "@id": "http://www.w3.org/2000/01/rdf-schema#label",
      "@container": "@set"
    },

    "hasIdentifier": {
      "@id": "https://dev.fiafcore.org/hasIdentifier",
      "@container": "@set"
    },

    "hasIdentifierAuthority": "https://dev.fiafcore.org/hasIdentifierAuthority",
    "hasIdentifierValue": "https://dev.fiafcore.org/hasIdentifierValue",
    "hasTitle": {
      "@id": "https://dev.fiafcore.org/hasTitle",
      "@container": "@set"
    },

    "hasTitleValue": "https://dev.fiafcore.org/hasTitleValue",
    "hasCountry": {
      "@id": "https://dev.fiafcore.org/hasCountry",
      "@container": "@set"
    },

    "hasGenre": {
      "@id": "https://dev.fiafcore.org/hasGenre",
      "@container": "@set"
    },
    "hasEvent": {
      "@id": "https://dev.fiafcore.org/hasEvent",
      "@container": "@set"
    },

    "hasActivity": "https://dev.fiafcore.org/hasActivity",
    "hasAgent": "https://dev.fiafcore.org/hasAgent",
    "hasManifestation": {
      "@id": "https://dev.fiafcore.org/hasManifestation",
      "@container": "@set"
    },

    "hasColourCharacteristic": "https://dev.fiafcore.org/hasColourCharacteristic",

    "hasSoundCharacteristic": "https://dev.fiafcore.org/hasSoundCharacteristic",
    "hasFormat": "https://dev.fiafcore.org/hasFormat",

    "hasItem": {
      "@id": "https://dev.fiafcore.org/hasItem",
      "@container": "@set"
    },

    "hasBase": "https://dev.fiafcore.org/hasBase",

    "hasHoldingInstitution": "https://dev.fiafcore.org/hasHoldingInstitution",

    "hasStatus": "https://dev.fiafcore.org/hasStatus",

    "isElement": "https://dev.fiafcore.org/isElement",

    "hasStock": "https://dev.fiafcore.org/hasStock"
  },
  "@id": "",
  "hasIdentifier": {
    "hasIdentifierAuthority": {
      "@embed": "@always"
    }
  },
  "hasManifestation": {
    "hasItem": {
      "hasBase": { "@embed": "@always" },
      "hasHoldingInstitution": { "@embed": "@always" },
      "hasStatus": { "@embed": "@always" },
      "isElement": { "@embed": "@always" },
      "hasStock": { "@embed": "@always" }
    }
  }
}
