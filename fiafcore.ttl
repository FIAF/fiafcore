.

<https://ontology.fiafcore.org/Person>
    a owl:Class ;
    rdfs:label "Person"@en ;
    dc:description "A single human being."@en ;
    dc:source <https://www.fiafnet.org/images/tinyUpload/E-Resources/Commission-And-PIP-Resources/CDC-resources/20160920_Fiaf_Manual-WEB.pdf#20160915%20Fiaf%20Manual-WEB.indd%3AAncrage%2047%3A79> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Agent> ;
.

<https://ontology.fiafcore.org/PostProductionEvent>
    a owl:Class ;
    rdfs:label "Post-Production Event"@en ;
    dc:description ""@en ;
