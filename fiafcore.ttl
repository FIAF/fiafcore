    rdfs:domain <https://ontology.fiafcore.org/Work> ;
    rdfs:range <https://vocabulary.fiafcore.org/Country> ;
.

<https://ontology.fiafcore.org/hasEvent>
    a owl:ObjectProperty ;
    rdfs:label
        "Has Event"@en ,
        "Tiene un Evento"@es ,
