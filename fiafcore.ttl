.

<https://ontology.fiafcore.org/OriginalCopyrightOwner>
    a owl:Class ;
    rdfs:label "Original Copyright Owner"@en ;
    dc:description "Copyright Owner (Original), Copyrighted by. The person or corporate body in whom first is vested the rights of ownership and protection against unauthorized use of an individual film, whether published or unpublished. This may or may not require registration depending on the laws of the country concerned."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CopyrightandDistributionActivity> ;
.

<https://ontology.fiafcore.org/OriginalDistributor>
    a owl:Class ;
    rdfs:label "Original Distributor"@en ;
    dc:description "Distributor (Original). The person or corporate body who organizes the first distribution of a film."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CopyrightandDistributionActivity> ;
.

