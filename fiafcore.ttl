<https://vocabulary.fiafcore.org/Country>
    a skos:ConceptScheme ;
    rdfs:label
        "Country"@en ,
        "País"@es ,
        "Pays"@fr ;
    dc:source
        "FIAF Moving Image Cataloguing Manual 1.3.3"@en ,
