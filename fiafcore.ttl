.

<https://ontology.fiafcore.org/PostProductionSupervisor>
    a owl:Class ;
    rdfs:label "Post-Production Supervisor"@en ;
    dc:description "Post-Production Supervisor. The individual who oversees the completion of the film following the shooting phase and coordinates various tasks involved in the post-production (editing, sound mixing, music score, visual effects, laboratory, preview screenings, etc)."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/Pre-ReleaseTitle>
    a owl:Class ;
    rdfs:label "Pre-Release Title"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-title.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/AlternativeTitle> ;
.

<https://ontology.fiafcore.org/PreReleaseManifestation>
    a owl:Class ;
    rdfs:label "Pre-Release Manifestation"@en ;
    dc:description "A moving image Manifestation type that may be used to represent any embodiments of a moving image Work that exist before the finalisation or release of the moving image Work."@en ;
    dc:source <https://www.fiafnet.org/images/tinyUpload/E-Resources/Commission-And-PIP-Resources/CDC-resources/20160920_Fiaf_Manual-WEB.pdf#20160915%20Fiaf%20Manual-WEB.indd%3A.36443%3A5140> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Manifestation> ;
.

<https://ontology.fiafcore.org/PreferredTitle>
    a owl:Class ;
    rdfs:label "Preferred Title"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-title.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Title> ;
.

<https://ontology.fiafcore.org/PrereleaseEvent>
    a owl:Class ;
    rdfs:label "Prerelease Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/PublicationEvent> ;
.

<https://ontology.fiafcore.org/PresentCopyrightOwner>
    a owl:Class ;
    rdfs:label "Present Copyright Owner"@en ;
    dc:description "Copyright Owner (Present). The person or corporate body to whom the original copyright owner or successors have legally transferred rights pertaining to ownership and protection against unauthorized use of an individual film, whether published or unpublished. Theatrical and television rights need not necessarily be vested in the same persons or companies."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CopyrightandDistributionActivity> ;
.

<https://ontology.fiafcore.org/Presenter>
    a owl:Class ;
    rdfs:label "Presenter"@en ;
    dc:description "Presenter, Presented by. A vanity credit; in early years, normally the head of a studio; today, a person or corporate body in some way associated with the production, financing, or distribution of the film."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/PreservationManifestation>
    a owl:Class ;
    rdfs:label "Preservation Manifestation"@en ;
    dc:description "Refers to manifestations which represent the outcome(s) of restoration events/activities, usually involving selection and aggregation of materials from diverse source elements to replicate an ‘original’ or ‘ideal’ manifestation."@en ;
    dc:source <https://www.fiafnet.org/images/tinyUpload/E-Resources/Commission-And-PIP-Resources/CDC-resources/20160920_Fiaf_Manual-WEB.pdf#20160915%20Fiaf%20Manual-WEB.indd%3A.36476%3A5148> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Manifestation> ;
.

<https://ontology.fiafcore.org/PreservationVariant>
    a owl:Class ;
    rdfs:label "Preservation Variant"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-variant.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Variant> ;
.

<https://ontology.fiafcore.org/Producer>
    a owl:Class ;
    rdfs:label "Producer"@en ;
    dc:description "Producer, Production, Produced by. The head of production who bears the ultimate administrative and financial responsibility for a film. In practice, the role of a Producer may be wider and can include creative involvement."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/ProductionAccountant>
    a owl:Class ;
    rdfs:label "Production Accountant"@en ;
    dc:description "Production Accountant, Production Auditor. The person responsible for keeping track of all expenditures during production and overseeing the payment of salaries and other expenses."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/ProductionAssistant>
    a owl:Class ;
    rdfs:label "Production Assistant"@en ;
    dc:description "Production Assistant, Runner, Gopher, Assistant to. The person responsible for various small tasks such as stopping traffic on the set, performing courier jobs, and fetching drinks and snacks. Production Assistants are often assigned to individual directors, producers, and actors."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/ProductionCompany>
    a owl:Class ;
    rdfs:label "Production Company"@en ;
    dc:description "Production Company. The name of the company under whose financial, technical and organizational management a film is made."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/ProductionCoordinator>
    a owl:Class ;
    rdfs:label "Production Coordinator"@en ;
    dc:description "Production Coordinator, Production Office Coordinator. The individual who runs the production office and as such is the Production Manager’s right-hand person. He or she handles the production’s paperwork, communications, equipment orders, deliveries, film shipments, etc."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/ProductionDesigner>
    a owl:Class ;
    rdfs:label "Production Designer"@en ;
    dc:description "Production Designer, Production Design. The person who conceives, plans, and supervises the overall physical look of a movie, and as such is responsible for almost everything that is placed before the camera (apart from the actors). Works closely with the Director and the Director of Photography from the earliest stages of the production. In smaller units, this role can be assumed by the Art Director."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProductionDesignActivity> ;
.

<https://ontology.fiafcore.org/ProductionManager>
    a owl:Class ;
    rdfs:label "Production Manager"@en ;
    dc:description "Production Manager, Unit Production Manager, Production Supervisor. The individual who manages all administrative and technical details of the production, from preparing the shooting schedule and negotiating crew and equipment contracts, to approving purchase orders and authorizing the payroll. In units with both a Production Supervisor and Production Manager, the former is usually subordinate to the latter, but may assume some of his or her responsibilities if the Production Manager also acts as the Co-producer."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/PropertyMaster>
    a owl:Class ;
    rdfs:label "Property Master"@en ;
    dc:description "Property Master, Props Master, Property Man, Prop Man, Props. The person in charge of purchasing, altering, or building the non-structural set furnishings (properties or props) to be used in the film, including furniture, books, lamps, curtains, cigarette lighters, etc. In units with both a Property Master and a Property Man, the latter usually functions as an assistant to the former."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProductionDesignActivity> ;
.

<https://ontology.fiafcore.org/Prosthetics>
    a owl:Class ;
    rdfs:label "Prosthetics"@en ;
    dc:description "Prosthetics. Special make-up effects that distort the appearance of an actor by applying to his or her skin materials such as rubber, plastic, metal, or cloth. These effects are also used to create the illusion of open and bleeding wounds."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SpecialEffectsActivity> ;
.

<https://ontology.fiafcore.org/Publicist>
    a owl:Class ;
    rdfs:label "Publicist"@en ;
    dc:description "Director of Publicity, Publicity Director, Unit Publicist, Publicist. Director of Publicity conceives and supervises the publicity campaign preceding and accompanying the film’s release. A Unit Publicist works on the set and/or location and is charged with arranging visits by members of the press, acting as a liaison between the production unit and the local population, and compiling notes on the making of the film for the movie’s press kit."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/Publisher>
    a owl:Class ;
    rdfs:label "Publisher"@en ;
    dc:description "Agent responsible for the home video publication or for the web publication of a moving image Manifestation."@en ;
    dc:source <https://www.fiafnet.org/images/tinyUpload/E-Resources/Commission-And-PIP-Resources/CDC-resources/20160920_Fiaf_Manual-WEB.pdf#20160915%20Fiaf%20Manual-WEB.indd%3A.36597%3A5177> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ManifestationActivity> ;
.

<https://ontology.fiafcore.org/Puppeteer>
    a owl:Class ;
    rdfs:label "Puppeteer"@en ;
    dc:description "Puppet Handler, Puppets Manipulated by, Puppeteer. The person who operates the puppets, whether by hand or with rods, strings or wireless control."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/PuppetActivity> ;
.

<https://ontology.fiafcore.org/PurchaseEvent>
    a owl:Class ;
    rdfs:label "Purchase Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/AcquisitionEvent> ;
.

<https://ontology.fiafcore.org/Pyrotechnics>
    a owl:Class ;
    rdfs:label "Pyrotechnics"@en ;
    dc:description "Pyrotechnics. Special effects involving incendiary devices which produce explosions, smoke, and fire."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SpecialEffectsActivity> ;
.

<https://ontology.fiafcore.org/RatingEvent>
    a owl:Class ;
    rdfs:label "Rating Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/DecisionEvent> ;
.

<https://ontology.fiafcore.org/Reel>
    a owl:Class ;
    rdfs:label "Reel"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-extent.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Extent> ;
.

<https://ontology.fiafcore.org/RegionalDistributor>
    a owl:Class ;
    rdfs:label "Regional Distributor"@en ;
    dc:description "Distributor (Regional), State Rights Distributor. The person or corporate body who organizes the regional distribution of a film. In the U.S., States Rights Distribution was a system prevalent during the silent era by which producers leased the rights to a film to independent distributors in individual states (as opposed to national distributors)."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CopyrightandDistributionActivity> ;
.

<https://ontology.fiafcore.org/ReleaseEvent>
    a owl:Class ;
    rdfs:label "Release Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/PublicationEvent> ;
.

<https://ontology.fiafcore.org/ReproductionEvent>
    a owl:Class ;
    rdfs:label "Reproduction Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/PreservationEvent> ;
.

<https://ontology.fiafcore.org/Research>
    a owl:Class ;
    rdfs:label "Research"@en ;
    dc:description "Research by, Researcher. An individual who performs detailed investigation to determine and authenticate subject matter, objects, and events in a film."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/WritingActivity> ;
.

<https://ontology.fiafcore.org/RestorationManifestation>
    a owl:Class ;
    rdfs:label "Restoration Manifestation"@en ;
    dc:description "Refers to manifestations which represent the outcome(s) of restoration events/activities, usually involving selection and aggregation of materials from diverse source elements to replicate an ‘original’ or ‘ideal’ manifestation."@en ;
    dc:source <https://www.fiafnet.org/images/tinyUpload/E-Resources/Commission-And-PIP-Resources/CDC-resources/20160920_Fiaf_Manual-WEB.pdf#20160915%20Fiaf%20Manual-WEB.indd%3A.36476%3A5148> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Manifestation> ;
.

<https://ontology.fiafcore.org/RestorationVariant>
    a owl:Class ;
    rdfs:label "Restoration Variant"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-variant.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Variant> ;
.

<https://ontology.fiafcore.org/RevisionEvent>
    a owl:Class ;
    rdfs:label "Revision Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/DecisionEvent> ;
.

<https://ontology.fiafcore.org/RightsCopyrightRegistrationEvent>
    a owl:Class ;
    rdfs:label "Rights/Copyright/Registration Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Event> ;
.

<https://ontology.fiafcore.org/RotoscopeArtist>
    a owl:Class ;
    rdfs:label "Rotoscope Artist"@en ;
    dc:description "Rotoscoping. The process of tracing frames of live action for creating mattes or animated figures."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SpecialEffectsActivity> ;
.

<https://ontology.fiafcore.org/ScanningEvent>
    a owl:Class ;
    rdfs:label "Scanning Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ManufactureEvent> ;
.

<https://ontology.fiafcore.org/ScenicArtist>
    a owl:Class ;
    rdfs:label "Scenic Artist"@en ;
    dc:description "Scenic Artist. Typically a painter responsible for creating murals, faux paintings, and painted graphics."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProductionDesignActivity> ;
.

<https://ontology.fiafcore.org/ScreenStory>
    a owl:Class ;
    rdfs:label "Screen Story"@en ;
    dc:description "Original Story, Story by, Screen Story. Original Story and Story by indicate a story written expressly for a film and not based on any existing work. Screen Story, on the other hand, is based on an existing work, but is at the same time substantially new or different from the source material."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/WritingActivity> ;
.

<https://ontology.fiafcore.org/SearchTitle>
    a owl:Class ;
    rdfs:label "Search Title"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-title.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/AlternativeTitle> ;
.

<https://ontology.fiafcore.org/Second>
    a owl:Class ;
    rdfs:label "Second"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-extent.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Extent> ;
.

<https://ontology.fiafcore.org/SecondUnitDirector>
    a owl:Class ;
    rdfs:label "Second Unit Director"@en ;
    dc:description "Second Unit Director. The person responsible for directing the second unit, a film crew charged with photographing scenes that do not necessarily require the presence of the Director and stars (stunts, crowd scenes, establishing shots, etc)."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/DirectingActivity> ;
.

<https://ontology.fiafcore.org/SecondUnitDirectorofPhotography>
    a owl:Class ;
    rdfs:label "Second Unit Director of Photography"@en ;
    dc:description "Second Unit Director of Photography, Second Unit Photography. The individual responsible for photographing scenes filmed by the Second Unit."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CinematographyActivity> ;
.

<https://ontology.fiafcore.org/SerialWork>
    a owl:Class ;
    rdfs:label "Serial Work"@en ;
    dc:description "Content issued in successive parts and intended to be continued indefinitely, or across a span of time. A Work record for a television series is catalogued as a “Serial.” Individual episodes may be catalogued as a Monographic record."@en ;
    dc:source <https://www.fiafnet.org/images/tinyUpload/E-Resources/Commission-And-PIP-Resources/CDC-resources/20160920_Fiaf_Manual-WEB.pdf#20160915%20Fiaf%20Manual-WEB.indd%3A.36384%3A5126> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Work> ;
.

<https://ontology.fiafcore.org/SeriesCreatedby>
    a owl:Class ;
    rdfs:label "Series Created by"@en ;
    dc:description "Series Created by. The person responsible for the conception and format of a series, but not necessarily for the content of its individual parts."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/WritingActivity> ;
.

<https://ontology.fiafcore.org/SeriesProducer>
    a owl:Class ;
    rdfs:label "Series Producer"@en ;
    dc:description "Series Producer, Series Production, Series Produced by. The person responsible for the overall production of a series, the individual parts of which may be written, directed, or produced by different people."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/SeriesTitle>
    a owl:Class ;
    rdfs:label "Series Title"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-title.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/AlternativeTitle> ;
.

<https://ontology.fiafcore.org/SetDecorator>
    a owl:Class ;
    rdfs:label "Set Decorator"@en ;
    dc:description "Set Decorator, Set Decoration, Set Dresser, Set Dressing, Decor, Decoration. The person who physically decorates (dresses) the set with props, furniture, artwork, etc."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProductionDesignActivity> ;
.

<https://ontology.fiafcore.org/SetDesigner>
    a owl:Class ;
    rdfs:label "Set Designer"@en ;
    dc:description "Set Designer, Set Design, Set(s) Designed by. The person who creates working construction drawings of the sets from the Production Designer’s (or Art Director’s) sketches."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProductionDesignActivity> ;
.

<https://ontology.fiafcore.org/SignedLanguage>
    a owl:Class ;
    rdfs:label "Signed Language"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-languageusage.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Dialogue> ;
.

<https://ontology.fiafcore.org/Silent>
    a owl:Class ;
    rdfs:label "Silent"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-soundcharacteristic.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SoundCharacteristic> ;
.

<https://ontology.fiafcore.org/Singer>
    a owl:Class ;
    rdfs:label "Singer"@en ;
    dc:description "Singer. A person who provides vocal music for the film and appears in it."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CastActivity> ;
.

<https://ontology.fiafcore.org/SingingVoice>
    a owl:Class ;
    rdfs:label "Singing Voice"@en ;
    dc:description "Singing Voice, Score Vocals Performed by, Playback Singer. A person who provides vocal music for the film without appearing in it. The voice may be dubbed in for a cast member who cannot sing but whose role calls for him or her to do so, or it may be used simply as part of background music."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/MusicActivity> ;
.

<https://ontology.fiafcore.org/SongComposer>
    a owl:Class ;
    rdfs:label "Song Composer"@en ;
    dc:description "Song Composer, Songs Composed by, Songs by. The person who creates the music for the songs to be used in the film. Songs by is a joint credit for the Song Composer and the Lyricist."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/MusicActivity> ;
.

<https://ontology.fiafcore.org/SonorizedVariant>
    a owl:Class ;
    rdfs:label "Sonorized Variant"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-variant.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Variant> ;
.

<https://ontology.fiafcore.org/Sony>
    a owl:Class ;
    rdfs:label "Sony"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-stock.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Stock> ;
.

<https://ontology.fiafcore.org/Sound>
    a owl:Class ;
    rdfs:label "Sound"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-soundcharacteristic.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SoundCharacteristic> ;
.

<https://ontology.fiafcore.org/SoundDesigner>
    a owl:Class ;
    rdfs:label "Sound Designer"@en ;
    dc:description "Sound Designer, Sound Design. The person who works with the Director to shape an overall, consistent audio track which is closely related to the film’s narrative and thematic needs. The term can also refer to a person charged with creating specific sound effects."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SoundActivity> ;
.

<https://ontology.fiafcore.org/SoundEditor>
    a owl:Class ;
    rdfs:label "Sound Editor"@en ;
    dc:description "Sound Editor, Sound Editing, Sound Edited by, Sound Effects Editor. The person primarily responsible for the selection, assembly, and synchronization of the film’s sound effects (as opposed to dialogue and music)."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SoundActivity> ;
.

<https://ontology.fiafcore.org/SoundEngineer>
    a owl:Class ;
    rdfs:label "Sound Engineer"@en ;
    dc:description "Sound Engineer, Re-recording Engineer. A technician responsible for maintaining the electronic and mechanical equipment associated with sound recording and/or re-recording. In the U.S. in the 1930’s, commonly used as an overall sound credit."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SoundActivity> ;
.

<https://ontology.fiafcore.org/SoundRecorderMixer>
    a owl:Class ;
    rdfs:label "Sound Recorder/Mixer"@en ;
    dc:description "Sound Recordist, Sound Recorder, Sound Recorded by, Production Sound Mixer, Production Mixer, Sound Mixer. The person responsible for recording sound during filming. Duties include selecting the microphones, operating the sound recorder, communicating with the Director about any audio related problems, keeping sound levels constant, etc. In this context, the term Production Sound Mixer (or Production Mixer/Sound Mixer) is primarily used in the U.S."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SoundActivity> ;
.

<https://ontology.fiafcore.org/SoundSupervisor>
    a owl:Class ;
    rdfs:label "Sound Supervisor"@en ;
    dc:description "Sound Supervisor. The person directly responsible to the Producer for all matters pertaining to the supplying, operating, and maintaining the sound equipment used in the making of a film."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SoundActivity> ;
.

<https://ontology.fiafcore.org/SourceMaterial>
    a owl:Class ;
    rdfs:label "Source Material"@en ;
    dc:description "Original Source, Source Material, Based on. The literary or any other work (novel, play, magazine story, poem, comic book, musical piece) upon which a film’s screenplay is based."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/WritingActivity> ;
.

<https://ontology.fiafcore.org/SpecialEffects>
    a owl:Class ;
    rdfs:label "Special Effects"@en ;
    dc:description "Special Effects, SFX, Effects, FX. A broad term used for any artificial visual or sound element produced by unusual mechanical, photographic, or digital means. In the U.S., the term Special Effects today primarily refers to Mechanical Effects."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SpecialEffectsActivity> ;
.

<https://ontology.fiafcore.org/SpokenLanguage>
    a owl:Class ;
    rdfs:label "Spoken Language"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-languageusage.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Dialogue> ;
.

<https://ontology.fiafcore.org/Sponsor>
    a owl:Class ;
    rdfs:label "Sponsor"@en ;
    dc:description "Sponsor, Sponsored by. An individual or company which finances the production of a film primarily for furtherance of public relations. Common on films made for non-theatrical distribution."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/Stagedby>
    a owl:Class ;
    rdfs:label "Staged by"@en ;
    dc:description "Staged by. The person who directed the stage play upon which a film is based."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/WritingActivity> ;
.

<https://ontology.fiafcore.org/StandIn>
    a owl:Class ;
    rdfs:label "Stand-In"@en ;
    dc:description "Stand-In. A person with approximately the same physical characteristics as a particular actor who takes his or her place in the lengthy set up of a shot."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CastActivity> ;
.

<https://ontology.fiafcore.org/SteadicamOperator>
    a owl:Class ;
    rdfs:label "Steadicam Operator"@en ;
    dc:description "Steadicam Operator. The person who operates a Steadicam, a hydraulically balanced camera apparatus which is attached to the body of the operator, enabling him or her to take smooth and steady shots while moving along with the action."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CinematographyActivity> ;
.

<https://ontology.fiafcore.org/StillPhotographer>
    a owl:Class ;
    rdfs:label "Still Photographer"@en ;
    dc:description "Still Photographer, Stills Photography. The person responsible for the taking of publicity and production photographs on the set and locations."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CinematographyActivity> ;
.

<https://ontology.fiafcore.org/StoryboardArtist>
    a owl:Class ;
    rdfs:label "Storyboard Artist"@en ;
    dc:description "Previsualization, Storyboard Artist, Production Illustrator, Illustrator. Previsualization refers to any system that enables the production personnel to see what a segment of the film will look like before the actual shooting. A traditional form of Previsualization is the Storyboard, a series of illustrations (sometimes resembling comic strip panels) that depict the various shots as seen through the camera lens, and often provide an outline of the film’s story (or a complex scene) with its action and characters. Today, Previsualization usually involves the creation of digital images and is often used for planning and designing visual effects."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProductionDesignActivity> ;
.

<https://ontology.fiafcore.org/Studio>
    a owl:Class ;
    rdfs:label "Studio"@en ;
    dc:description "Studio, Location of Studios. The name and location of the production facility or facilities in which all or part of the film was made."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/StuntArranger>
    a owl:Class ;
    rdfs:label "Stunt Arranger"@en ;
    dc:description "Stunt Arranger, Stunts Arranged by, Stunt Coordinator. A specialist who plans action sequences to be performed by stunt men and women."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/DirectingActivity> ;
.

<https://ontology.fiafcore.org/StuntPerformer>
    a owl:Class ;
    rdfs:label "Stunt Performer"@en ;
    dc:description "Stunt Man, Stunt Woman, Stunt Performer, Stunts. A professional who performs feats required by the script which are difficult or appear dangerous."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CastActivity> ;
.

<https://ontology.fiafcore.org/SubtitledVariant>
    a owl:Class ;
    rdfs:label "Subtitled Variant"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-variant.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Variant> ;
.

<https://ontology.fiafcore.org/Subtitles>
    a owl:Class ;
    rdfs:label "Subtitles"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-languageusage.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/WrittenLanguage> ;
.

<https://ontology.fiafcore.org/SungLanguage>
    a owl:Class ;
    rdfs:label "Sung Language "@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-languageusage.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Dialogue> ;
.

<https://ontology.fiafcore.org/SupervisingSoundEditor>
    a owl:Class ;
    rdfs:label "Supervising Sound Editor"@en ;
    dc:description "Supervising Sound Editor. The person who oversees the sound editorial process, during which dialogue, music, and sound effects are edited in preparation for the final mix. He or she also supervises the final mix itself."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SoundActivity> ;
.

<https://ontology.fiafcore.org/SuppliedDevisedTitle>
    a owl:Class ;
    rdfs:label "Supplied/Devised Title"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-title.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Title> ;
.

<https://ontology.fiafcore.org/TelecineEvent>
    a owl:Class ;
    rdfs:label "Telecine Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ManufactureEvent> ;
.

<https://ontology.fiafcore.org/Terabyte>
    a owl:Class ;
    rdfs:label "Terabyte"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-extent.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Extent> ;
.

<https://ontology.fiafcore.org/TheatricalDistributionEvent>
    a owl:Class ;
    rdfs:label "Theatrical Distribution Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/PublicationEvent> ;
.

<https://ontology.fiafcore.org/TheatricalManifestation>
    a owl:Class ;
    rdfs:label "Theatrical Manifestation"@en ;
    dc:description "A moving image Manifestation type representing Manifestations distributed and exhibited in cinema theatres."@en ;
    dc:source <https://www.fiafnet.org/images/tinyUpload/E-Resources/Commission-And-PIP-Resources/CDC-resources/20160920_Fiaf_Manual-WEB.pdf#20160915%20Fiaf%20Manual-WEB.indd%3A.36447%3A5141> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Manifestation> ;
.

<https://ontology.fiafcore.org/Tinted>
    a owl:Class ;
    rdfs:label "Tinted"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-colourcharacteristic.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ColourCharacteristic> ;
.

<https://ontology.fiafcore.org/TitleDesigner>
    a owl:Class ;
    rdfs:label "Title Designer"@en ;
    dc:description "Title Design, Titles Designed by, Title Designer, Titles. The individual, usually a graphic designer, who plans, designs, and creates front, interior, and/or end titles (i.e. credits). This task may also extend to the actual making and inserting of all titles which are to be included in the film."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProductionDesignActivity> ;
.

<https://ontology.fiafcore.org/TitleProper>
    a owl:Class ;
    rdfs:label "Title Proper"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-title.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Title> ;
.

<https://ontology.fiafcore.org/Toned>
    a owl:Class ;
    rdfs:label "Toned"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-colourcharacteristic.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ColourCharacteristic> ;
.

<https://ontology.fiafcore.org/TransferEvent>
    a owl:Class ;
    rdfs:label "Transfer Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/PreservationEvent> ;
.

<https://ontology.fiafcore.org/TranslatedTitle>
    a owl:Class ;
    rdfs:label "Translated Title"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-title.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/AlternativeTitle> ;
.

<https://ontology.fiafcore.org/TransliteratedTitle>
    a owl:Class ;
    rdfs:label "Transliterated Title"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-title.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/AlternativeTitle> ;
.

<https://ontology.fiafcore.org/TransportationManager>
    a owl:Class ;
    rdfs:label "Transportation Manager"@en ;
    dc:description "Transportation Manager, Transportation Coordinator. The person who manages the drivers and coordinates the transportation of cast, crew, and equipment between various locations."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProducingActivity> ;
.

<https://ontology.fiafcore.org/UnderwaterPhotography>
    a owl:Class ;
    rdfs:label "Underwater Photography"@en ;
    dc:description "Underwater Cameraman, Underwater Photography, Underwater Sequences. Cameraman for underwater shots."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CinematographyActivity> ;
.

<https://ontology.fiafcore.org/UnreleasedManifestation>
    a owl:Class ;
    rdfs:label "Unreleased Manifestation"@en ;
    dc:description "Refers to Manifestations which do not represent a release/distribution event, but where the work was intended for release, e.g. the film was made, completed and intended for release, but was not then released due to censorship or political impediments, or other reason."@en ;
    dc:source <https://www.fiafnet.org/images/tinyUpload/E-Resources/Commission-And-PIP-Resources/CDC-resources/20160920_Fiaf_Manual-WEB.pdf#20160915%20Fiaf%20Manual-WEB.indd%3A.36459%3A5144> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Manifestation> ;
.

<https://ontology.fiafcore.org/UploadingEvent>
    a owl:Class ;
    rdfs:label "Uploading Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ManufactureEvent> ;
.

<https://ontology.fiafcore.org/VideoAssist>
    a owl:Class ;
    rdfs:label "Video Assist"@en ;
    dc:description "Video Assist Operator, Video Assist. The person responsible for the Video Assist system which, plugged into the motion picture camera, allows the director and other production personnel to view on a video monitor (live or on tape) the exact image as it will be exposed on the film. Often used to evaluate a take immediately after it is shot."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CinematographyActivity> ;
.

<https://ontology.fiafcore.org/VideoCopyingEvent>
    a owl:Class ;
    rdfs:label "VideoCopying Event"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-event.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ManufactureEvent> ;
.

<https://ontology.fiafcore.org/VisualEffects>
    a owl:Class ;
    rdfs:label "Visual Effects"@en ;
    dc:description "Visual Effects, VFX, Photographic Effects, Special Photographic Effects, Optical Effects. Visual Effects are special effects generated with the aid of photographic or digital technology, usually in post-production. More specifically, Photographic Effects denote effects achieved through special photographic techniques (e.g. Traveling Matte), while Optical Effects refer to special effects generated in an optical printer using already exposed film (e.g. dissolves and fades). Today, Visual Effects are often synonymous with Computer Generated Imagery."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/SpecialEffectsActivity> ;
.

<https://ontology.fiafcore.org/Voices>
    a owl:Class ;
    rdfs:label "Voices"@en ;
    dc:description "Voices by. Individuals who supply voices for characters appearing in the film. Common credit on animated and puppet films."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CastActivity> ;
.

<https://ontology.fiafcore.org/WardrobeSupervisor>
    a owl:Class ;
    rdfs:label "Wardrobe Supervisor"@en ;
    dc:description "Wardrobe Supervisor, Wardrobe Supervision, Wardrobe Master, Wardrobe Mistress. The wardrobe personnel is primarily responsible for physically handling and maintaining the costumes and related accessories on the set, and making sure that the cast members are properly dressed for each scene to be photographed."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/ProductionDesignActivity> ;
.

<https://ontology.fiafcore.org/WorkingTitle>
    a owl:Class ;
    rdfs:label "Working Title"@en ;
    dc:description ""@en ;
    dc:source <file:///Users/pduc/git/fiafcore/ontology/fiafcore-title.ttl> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/AlternativeTitle> ;
.

<https://ontology.fiafcore.org/WorldDistributor>
    a owl:Class ;
    rdfs:label "World Distributor"@en ;
    dc:description "Distributor (World). The person or corporate body who organizes the world-wide (international) distribution of a film."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CopyrightandDistributionActivity> ;
.

<https://ontology.fiafcore.org/Wrangler>
    a owl:Class ;
    rdfs:label "Wrangler"@en ;
    dc:description "Wrangler. The person responsible for handling all livestock (horses, mules, cows, sheep, and pigs) to be used in the film. Today, the term has a wider use, and can be applied not only to other animals (e.g. bug wrangler), but also to a variety of unrelated production jobs such as working with extras (extras wrangler) and even manipulating digital data (data wrangler)."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/CastActivity> ;
.

<https://ontology.fiafcore.org/Writer>
    a owl:Class ;
    rdfs:label "Writer"@en ;
    dc:description "Screenplay by, Writer, Written by. Screen credit for the author(s) of a screenplay. In the U.S., the credit Written by indicates that the author(s) wrote both the film’s original story and the screenplay."@en ;
    dc:source <https://www.fiafnet.org/pages/E-Resources/Glossary.html> ;
    rdfs:subClassOf <https://ontology.fiafcore.org/WritingActivity> ;
.

