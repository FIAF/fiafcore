    dc:creator "FIAF Cataloguing and Documentation Commission" ;
    dc:title "FIAFcore" ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/" ;
    owl:versionInfo "dev-2.0.0" ;
.

