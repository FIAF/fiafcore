PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

### Class

<https://dev.fiafcore.org/ColourEncoding> a owl:Class ;
    rdfs:label "Colour Encoding"@en ;
    dc:description "A digital colour encoding used to represent colour values in a moving image file."@en ;
    dc:source <> ;
.

### Subclasses

<https://dev.fiafcore.org/Greyscale> a owl:Class ;
    rdfs:label "Greyscale"@en ;
    dc:description "A single-channel monochrome digital pixel encoding."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/ColourEncoding> ;
.

<https://dev.fiafcore.org/RGB> a owl:Class ;
    rdfs:label "RGB"@en ;
    dc:description "A digital colour encoding using red, green, and blue channels."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/ColourEncoding> ;
.

<https://dev.fiafcore.org/XYZ> a owl:Class ;
    rdfs:label "XYZ"@en ;
    dc:description "A digital colour encoding based on the CIE 1931 XYZ colour model, used in Digital Cinema Distribution Masters and Digital Cinema Packages."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/ColourEncoding> ;
.

<https://dev.fiafcore.org/YUV> a owl:Class ;
    rdfs:label "YUV"@en ;
    skos:altLabel "Y′CbCr"@en ;
    dc:description "A digital colour encoding using one luma and two chrominance components (in digital video, Y′CbCr)."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/ColourEncoding> ;
.

