PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

### Class

<https://dev.fiafcore.org/Extent> a owl:Class ;
    rdfs:label "Extent"@en ;
    dc:description "A measurement of a Manifestation or Item, typed by its unit and carrying its value with hasExtentValue. Each measurement is a separate node."@en ;
    dc:source <> ;
.

### Subclasses

# Physical extent

<https://dev.fiafcore.org/PhysicalExtent> a owl:Class ;
    rdfs:label "Physical Extent"@en ;
    dc:description "The physical length of film or tape, or the data size of a digital object."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/Extent> ;
.

<https://dev.fiafcore.org/Foot> a owl:Class ;
    rdfs:label "Foot"@en ;
    dc:description "A length measured in feet."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/PhysicalExtent> ;
.

<https://dev.fiafcore.org/Metre> a owl:Class ;
    rdfs:label "Metre"@en ;
    dc:description "A length measured in metres."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/PhysicalExtent> ;
.

<https://dev.fiafcore.org/Byte> a owl:Class ;
    rdfs:label "Byte"@en ;
    dc:description "A data size measured in bytes. The preferred unit for the size of a digital object, because it is exact."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/PhysicalExtent> ;
.

<https://dev.fiafcore.org/Kilobyte> a owl:Class ;
    rdfs:label "Kilobyte"@en ;
    dc:description "A data size measured in kilobytes (1 kilobyte = 1,000 bytes). Where the exact size is known, use Byte."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/PhysicalExtent> ;
.

<https://dev.fiafcore.org/Megabyte> a owl:Class ;
    rdfs:label "Megabyte"@en ;
    dc:description "A data size measured in megabytes (1 megabyte = 1,000,000 bytes). Where the exact size is known, use Byte."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/PhysicalExtent> ;
.

<https://dev.fiafcore.org/Gigabyte> a owl:Class ;
    rdfs:label "Gigabyte"@en ;
    dc:description "A data size measured in gigabytes (1 gigabyte = 10^9 bytes). Where the exact size is known, use Byte."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/PhysicalExtent> ;
.

<https://dev.fiafcore.org/Terabyte> a owl:Class ;
    rdfs:label "Terabyte"@en ;
    dc:description "A data size measured in terabytes (1 terabyte = 10^12 bytes). Where the exact size is known, use Byte."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/PhysicalExtent> ;
.

# Duration

<https://dev.fiafcore.org/Duration> a owl:Class ;
    rdfs:label "Duration"@en ;
    dc:description "The running time of the moving image content."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/Extent> ;
.

<https://dev.fiafcore.org/Minute> a owl:Class ;
    rdfs:label "Minute"@en ;
    dc:description "A duration measured in minutes."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/Duration> ;
.

<https://dev.fiafcore.org/Second> a owl:Class ;
    rdfs:label "Second"@en ;
    dc:description "A duration measured in seconds."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/Duration> ;
.

# Unit count

<https://dev.fiafcore.org/Reel> a owl:Class ;
    rdfs:label "Reel"@en ;
    dc:description "A number of reels."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/Extent> ;
.

### Datatype Properties

<https://dev.fiafcore.org/hasExtentValue>
    a owl:DatatypeProperty ;
    rdfs:label "Has Extent Value"@en ;
    dc:description "The value of a measurement, expressed in the unit given by the type of the Extent node."@en ;
    dc:source <> ;
    rdfs:domain <https://dev.fiafcore.org/Extent> ;
    rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
.

### Object Properties

# None
