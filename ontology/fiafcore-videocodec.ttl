PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

### Class

<https://dev.fiafcore.org/VideoCodec> a owl:Class ;
    rdfs:label "Video Codec"@en ;
    dc:description "An encoding of a digital video stream, independent of its enclosing file format."@en ;
    dc:source <> ;
.

### Subclasses

<https://dev.fiafcore.org/FFV1> a owl:Class ;
    dc:description "FFV1, a lossless intra-frame video codec used for preservation masters."@en ;
    dc:source <> ;
    rdfs:label "FFV1"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/VideoCodec> ;
.

<https://dev.fiafcore.org/MPEG2> a owl:Class ;
    dc:description "MPEG-2 video."@en ;
