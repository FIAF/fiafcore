    rdfs:subClassOf <https://dev.fiafcore.org/VideoCodec> ;
.

<https://dev.fiafcore.org/ProRes> a owl:Class ;
    dc:description "The Apple ProRes family of video codecs."@en ;
    dc:source <> ;
    rdfs:label "ProRes"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/VideoCodec> ;
.

<https://dev.fiafcore.org/ProRes422HQ> a owl:Class ;
    dc:description "Apple ProRes 422 HQ, a high quality 4:2:2 ProRes variant."@en ;
    dc:source <> ;
    rdfs:label "ProRes 422 HQ"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/ProRes> ;
.

<https://dev.fiafcore.org/RealVideo> a owl:Class ;
    dc:description "The RealVideo family of video codecs."@en ;
    dc:source <> ;
    rdfs:label "Real Video"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/VideoCodec> ;
.

<https://dev.fiafcore.org/WindowsMedia> a owl:Class ;
    dc:description "The Windows Media family of video codecs."@en ;
    dc:source <> ;
