PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

### Class

<https://ontology.fiafcore.org/Activity>
    a owl:Class ;
    rdfs:label
        "Activity"@en ;
    dc:description
        "This describes the activity or role of the Agent in relation to the moving image Work/Variant, or to make explicit the relationship(s) between the Agent and the Manifestation or Item."@en ;
    dc:source 
        <https://www.fiafnet.org/images/tinyUpload/E-Resources/Commission-And-PIP-Resources/CDC-resources/20160920_Fiaf_Manual-WEB.pdf#20160915%20Fiaf%20Manual-WEB.indd%3AAncrage%2048%3A80> ;
.

### Object Properties

<https://ontology.fiafcore.org/hasAgent>
    a owl:ObjectProperty ;
    rdfs:label 
        "Has Agent"@en ; 
    dc:description
        "Express the relationship between an Activity and an Agent."@en ;
    dc:source 
        <> ;
    rdfs:domain 
        <https://ontology.fiafcore.org/Activity> ;   
    rdfs:range 
        <https://ontology.fiafcore.org/Agent> ;   
.
