PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

### Class

<https://ontology.fiafcore.org/Variant>
    a owl:Class ;
    rdfs:label
        "Variant"@en ;
    dc:description
        "A moving image Variant is an entity that may be used to indicate any change to content-related characteristics that do not significantly change the overall content of a Work as a whole."@en ;
    dc:source 
        <https://www.fiafnet.org/images/tinyUpload/E-Resources/Commission-And-PIP-Resources/CDC-resources/20160920_Fiaf_Manual-WEB.pdf#20160915%20Fiaf%20Manual-WEB.indd%3A.35990%3A5031> ;
.

### Object Properties

<https://ontology.fiafcore.org/hasEvent>
    a owl:ObjectProperty ;
    rdfs:label 
        "Has Event"@en ; 
    dc:description
        "An Event characterises occurrences in the lifecycle of a moving image Work, Variant, Manifestation, Item or Carrier."@en ;
    dc:source 
        <> ;
    rdfs:domain 
        [ owl:unionOf (<https://ontology.fiafcore.org/Work> <https://ontology.fiafcore.org/Variant> <https://ontology.fiafcore.org/Manifestation> <https://ontology.fiafcore.org/Item> <https://ontology.fiafcore.org/Carrier>) ] ;
    rdfs:range 
        <https://ontology.fiafcore.org/Event> ;   
.
 
<https://ontology.fiafcore.org/hasIdentifier>
    a owl:ObjectProperty ;
    rdfs:label 
        "Has Identifier"@en ; 
    dc:description
        "An Identifier refers to a specific entity and provides clear disambiguation between entities to avoid confusion."@en ;
    dc:source 
        <> ;
    rdfs:domain 
        [ owl:unionOf (<https://ontology.fiafcore.org/Work> <https://ontology.fiafcore.org/Variant> <https://ontology.fiafcore.org/Manifestation> <https://ontology.fiafcore.org/Item> <https://ontology.fiafcore.org/Carrier> <https://ontology.fiafcore.org/Agent>) ] ;
    rdfs:range 
        <https://ontology.fiafcore.org/Identifier> ;   
.  
  
<https://ontology.fiafcore.org/hasLanguageUsage>
    a owl:ObjectProperty ;
    rdfs:label 
        "Has Language Usage"@en ;
    dc:description
        "Record the usage type of a language e.g. spoken, intertitles, subtitles, etc."@en ;
    dc:source 
        <> ;
    rdfs:domain 
        [ owl:unionOf (<https://ontology.fiafcore.org/Work> <https://ontology.fiafcore.org/Variant> <https://ontology.fiafcore.org/Manifestation>) ] ;
    rdfs:range 
        <https://ontology.fiafcore.org/LanguageUsage> ;
.
    
<https://ontology.fiafcore.org/hasManifestation>
    a owl:ObjectProperty ;
    rdfs:label 
        "Has Manifestation"@en ; 
    dc:description
        "Express the relationship between a moving image Work or Variant and a moving image Manifestation."@en ;
    dc:source 
        <> ;
    rdfs:domain 
        <https://ontology.fiafcore.org/Variant> ; 
    rdfs:range 
        <https://ontology.fiafcore.org/Manifestation> ;   
.  
  
<https://ontology.fiafcore.org/hasTitle>
    a owl:ObjectProperty ;
    rdfs:label 
        "Has Title"@en ; 
    dc:description
        "Record a title, identifying phrase, or name for the moving image Work, Variant, Manifestation or Item."@en ;
    dc:source 
        <> ;
    rdfs:domain 
        [ owl:unionOf (<https://ontology.fiafcore.org/Work> <https://ontology.fiafcore.org/Variant> <https://ontology.fiafcore.org/Manifestation> <https://ontology.fiafcore.org/Item>) ] ;
    rdfs:range 
        <https://ontology.fiafcore.org/Title> ;   
.  
  
  
  





































<https://ontology.fiafcore.org/Variant>
    a owl:Class ;
    rdfs:label
        "Variant"@en ,
        "Variante"@es ,
        "la Variante"@fr ;
    dc:description
        "A moving image Variant is an entity that may be used to indicate any change to content-related characteristics that do not significantly change the overall content of a Work as a whole."@en ,
        "Una Variante de imágenes en movimiento es una entidad que puede usarse para indicar cualquier cambio en las características relativas al contenido, que no modifican de manera significativa el contenido general de una obra como un todo."@es ,
        "Une Variante est une entité utilisée pour indiquer tout changement dans les caractéristiques liées au contenu, qui ne modifie pas de façon significative le contenu global d'une Œuvre dans son ensemble."@fr ;
    dc:source
        "FIAF Moving Image Cataloguing Manual 1.0.2"@en ,
        "Manual FIAF de Catalogación de Imágenes en Movimiento 1.0.2"@es ,
        "Manuel de catalogage des images animées de la FIAF 1.0.2"@fr ;
.












### Subclasses

<https://ontology.fiafcore.org/AbridgedCondensed>
    a owl:Class ;
    rdfs:label
        "Abridged/Condensed"@en ,
        "Abreviada/Condensada"@es ,
        "Raccourci/condensé"@fr ;
    dc:source
        "FIAF Moving Image Cataloguing Manual D.2"@en ,
        "Manual FIAF de Catalogación de Imágenes en Movimiento D.2"@es ,
        "Manuel de catalogage des images animées de la FIAF D.2"@fr ;
    rdfs:subClassOf <https://ontology.fiafcore.org/Variant> ;
.

