PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

### Class

<https://dev.fiafcore.org/Format> a owl:Class ;
    rdfs:label "Format"@en ;
    dc:description "The physical or digital technical form of a moving image object, identifying the family of equipment or software needed to read, decode, or play back that specific object. A storage medium and a digital object stored on it are separate objects with separate formats. Digital stream encodings are described separately with hasVideoCodec or hasAudioCodec."@en ;
    dc:source <> ;
.

### Subclasses

# Film formats

<https://dev.fiafcore.org/FilmFormat> a owl:Class ;
    dc:description "A perforated motion-picture film format, photochemical or magnetic, read with sprocketed film equipment such as projectors, flatbed editors and viewers, sound followers, or film scanners."@en ;
    dc:source <> ;
    rdfs:label "Film Format"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/Format> ;
.

<https://dev.fiafcore.org/8mmFilm> a owl:Class ;
    dc:description ""@en ;
    rdfs:label "8mm Film"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/FilmFormat> ;
.

<https://dev.fiafcore.org/9.5mmFilm> a owl:Class ;
    dc:description ""@en ;
