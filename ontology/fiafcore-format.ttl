# Deprecated groupings

<https://dev.fiafcore.org/OpticalFormat> a owl:Class ;
    dc:description "Deprecated: optical discs are now classed by function rather than by reading method. Use Video Disc, Audio Disc, or Data Storage Format."@en ;
    rdfs:label "Optical Format"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/Format> ;
    owl:deprecated true ;
    dcterms:isReplacedBy <https://dev.fiafcore.org/VideoDisc> ,
        <https://dev.fiafcore.org/AudioDisc> ,
        <https://dev.fiafcore.org/DataStorageFormat> ;
.

