    dc:source <> ;
    rdfs:label "28mm Film"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/FilmFormat> ;
.

<https://dev.fiafcore.org/35mmFilm> a owl:Class ;
    dc:description ""@en ;
    rdfs:label "35mm Film"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/FilmFormat> ;
.

<https://dev.fiafcore.org/65mmFilm> a owl:Class ;
    dc:description "A perforated 65mm motion-picture film format, commonly used for large-format camera negatives."@en ;
    dc:source <> ;
    rdfs:label "65mm Film"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/FilmFormat> ;
.

<https://dev.fiafcore.org/70mmFilm> a owl:Class ;
    dc:description ""@en ;
