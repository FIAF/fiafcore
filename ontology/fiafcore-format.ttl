# Data storage formats

<https://dev.fiafcore.org/DataStorageFormat> a owl:Class ;
    dc:description "A physical storage medium read by a computer drive, holding digital data without determining the format of the digital objects stored on it, such as data tape, a hard disk drive, an optical data disc, or flash memory. Whether a disc is recordable or pressed does not by itself make it a data storage format; an authored audio or video disc is an audio or video format."@en ;
    dc:source <> ;
    rdfs:label "Data Storage Format"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/Format> ;
.

<https://dev.fiafcore.org/CDROM> a owl:Class ;
    dc:description "A read-only compact disc used to distribute digital data, rather than Compact Disc Digital Audio."@en ;
    dc:source <> ;
    rdfs:label "CD-ROM"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/DataStorageFormat> ;
.

<https://dev.fiafcore.org/DVDROM> a owl:Class ;
    dc:description "A read-only DVD used to distribute digital data, rather than an authored DVD-Video release."@en ;
    dc:source <> ;
    rdfs:label "DVD-ROM"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/DataStorageFormat> ;
.

<https://dev.fiafcore.org/CDR> a owl:Class ;
    dc:description "A recordable compact disc used as an offline digital data storage carrier."@en ;
    dc:source <> ;
    rdfs:label "CD-R"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/DataStorageFormat> ;
.

<https://dev.fiafcore.org/DVDR> a owl:Class ;
    dc:description "A recordable DVD used as an offline digital data storage carrier."@en ;
    dc:source <> ;
    rdfs:label "DVD-R"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/DataStorageFormat> ;
.

<https://dev.fiafcore.org/LTO> a owl:Class ;
    dc:description "Linear Tape-Open magnetic data tape storage format."@en ;
    dc:source <> ;
    rdfs:label "LTO"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/DataStorageFormat> ;
.

