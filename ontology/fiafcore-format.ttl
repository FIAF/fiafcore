.

<https://dev.fiafcore.org/Super8mmFilm> a owl:Class ;
    dc:description ""@en ;
    rdfs:label "Super 8mm Film"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/FilmFormat> ;
.

<https://dev.fiafcore.org/MagneticFilm> a owl:Class ;
    dc:description "Perforated film carrying a magnetic sound recording, fullcoat or stripe on a clear base, played on flatbed editors and viewers or sound followers rather than projectors. Use when the gauge is unknown. A picture print with a magnetic stripe is a picture film format with a magnetic sound standard, not magnetic film."@en ;
    dc:source <> ;
    rdfs:label "Magnetic Film"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/FilmFormat> ;
.

<https://dev.fiafcore.org/16mmMagneticFilm> a owl:Class ;
    dc:description "16mm perforated magnetic film carrying sound only."@en ;
    dc:source <> ;
    rdfs:label "16mm Magnetic Film"@en ;
