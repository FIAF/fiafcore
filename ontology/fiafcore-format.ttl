.

<https://dev.fiafcore.org/35mmMagneticFilm> a owl:Class ;
    dc:description "35mm perforated magnetic film carrying sound only, fullcoat or stripe on a clear base."@en ;
    dc:source <> ;
    rdfs:label "35mm Magnetic Film"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/MagneticFilm> ;
.

# Audio formats

<https://dev.fiafcore.org/AudioFormat> a owl:Class ;
    dc:description "A physical audio carrier other than film, played on audio playback equipment, such as open-reel magnetic tape, an audio cassette, or an audio compact disc."@en ;
    dc:source <> ;
    rdfs:label "Audio Format"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/Format> ;
.

<https://dev.fiafcore.org/AudioTape> a owl:Class ;
    dc:description "A magnetic audio tape or audio cassette format. Use when no more specific format is known. Excludes perforated magnetic film."@en ;
    dc:source <> ;
    rdfs:label "Audio Tape"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/AudioFormat> ;
.

<https://dev.fiafcore.org/Audiocassette> a owl:Class ;
    dc:description ""@en ;
    rdfs:label "Audiocassette"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/AudioTape> ;
.

<https://dev.fiafcore.org/DAT> a owl:Class ;
    dc:description "Digital Audio Tape, a 3.81mm (0.15 inch) magnetic cassette tape format for digital audio recording."@en ;
    dc:source <> ;
    rdfs:label "DAT"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/AudioTape> ;
.

<https://dev.fiafcore.org/DTRS> a owl:Class ;
    dc:description "Digital Tape Recording System, an eight-track modular digital multitrack tape format."@en ;
    dc:source <> ;
    rdfs:label "DTRS"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/AudioTape> ;
.

<https://dev.fiafcore.org/OpenReelAudiotape> a owl:Class ;
    dc:description "An open-reel magnetic audio tape format, with tape width unspecified unless a narrower term is used. Excludes perforated magnetic film."@en ;
    dc:source <> ;
    rdfs:label "Open-Reel Audiotape"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/AudioTape> ;
.

<https://dev.fiafcore.org/HalfInchAudiotape> a owl:Class ;
    dc:description ""@en ;
    rdfs:label "Half Inch Audiotape"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/OpenReelAudiotape> ;
.

<https://dev.fiafcore.org/OneInchAudiotape> a owl:Class ;
    dc:description ""@en ;
    rdfs:label "One Inch Audiotape"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/OpenReelAudiotape> ;
.

<https://dev.fiafcore.org/QuarterInchAudiotape> a owl:Class ;
    dc:description "Quarter-inch open-reel magnetic audio tape."@en ;
    dc:source <> ;
    rdfs:label "Quarter Inch Audiotape"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/OpenReelAudiotape> ;
.

<https://dev.fiafcore.org/QuerterInchAudiotape> a owl:Class ;
    dc:description "Deprecated misspelt term; use Quarter Inch Audiotape."@en ;
    rdfs:label "Querter Inch Audiotape"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/OpenReelAudiotape> ;
    owl:deprecated true ;
    dcterms:isReplacedBy <https://dev.fiafcore.org/QuarterInchAudiotape> ;
.

<https://dev.fiafcore.org/TwoInchAudiotape> a owl:Class ;
    dc:description ""@en ;
    rdfs:label "Two Inch Audiotape"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/OpenReelAudiotape> ;
.

<https://dev.fiafcore.org/AudioDisc> a owl:Class ;
    dc:description "A physical audio disc format played on an audio disc player. Use when no more specific format is known."@en ;
    dc:source <> ;
    rdfs:label "Audio Disc"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/AudioFormat> ;
.

<https://dev.fiafcore.org/CD> a owl:Class ;
    dc:description "An optical audio disc in Compact Disc Digital Audio format."@en ;
    dc:source <> ;
    rdfs:label "CD"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/AudioDisc> ;
.

