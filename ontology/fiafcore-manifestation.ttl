        "Manuel de catalogage des images animées de la FIAF 2.3.5, 3.1.5.8"@fr ;
    rdfs:domain [
        owl:unionOf (<https://ontology.fiafcore.org/Manifestation> <https://ontology.fiafcore.org/Item>)
    ] ;        
    rdfs:range <https://ontology.fiafcore.org/Extent> ;
